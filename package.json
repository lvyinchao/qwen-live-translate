{
  "name": "qwen-video-dub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-brand.mjs && node scripts/prepare-assets.mjs",
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "package": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:browser": "node scripts/browser-ui.mjs && node scripts/gate-discovery.mjs && node scripts/gate-youtube-player.mjs",
    "prepare:store": "node scripts/prepare-store-assets.mjs"
  },
  "dependencies": {
    "googlevideo": "file:vendor/googlevideo-4.1.1-qvd.96d1418.tgz",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.22.0",
    "wxt": "^0.20.0"
  },
  "description": "Open-source Chrome extension for synchronized original-voice video translation with Qwen LiveTranslate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvyinchao/qwen-live-translate.git"
  },
  "homepage": "https://github.com/lvyinchao/qwen-live-translate",
  "bugs": {
    "url": "https://github.com/lvyinchao/qwen-live-translate/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
