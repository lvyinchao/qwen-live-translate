{
  "name": "timbradub",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-brand.mjs && node scripts/prepare-assets.mjs",
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "package": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:browser": "node scripts/browser-ui.mjs && node scripts/gate-discovery.mjs && node scripts/gate-youtube-player.mjs && node scripts/gate-playback-state.mjs && node scripts/gate-playback-audio.mjs && node scripts/gate-panel-storage.mjs && node scripts/gate-language-switch.mjs && node scripts/gate-range-source.mjs && node scripts/gate-local-files.mjs",
    "prepare:store": "node scripts/prepare-store-assets.mjs",
    "verify:media-source": "node scripts/check-media-source.mjs",
    "audit:deps": "npm audit --audit-level=low --registry=https://registry.npmjs.org",
    "test:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "googlevideo": "file:vendor/googlevideo-4.1.1-qvd.96d1418.tgz",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.56.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.4",
    "ws": "^8.22.0",
    "wxt": "0.21.4",
    "vite": "8.3.4",
    "fflate": "0.8.3"
  },
  "description": "Translate video speech in the original voice, with synchronized audio, bilingual subtitles and 29 target languages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvyinchao/timbradub.git"
  },
  "homepage": "https://github.com/lvyinchao/timbradub",
  "bugs": {
    "url": "https://github.com/lvyinchao/timbradub/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
