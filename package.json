{
  "name": "timbradub",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-brand.mjs && node scripts/prepare-assets.mjs",
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "package": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:browser": "node scripts/browser-ui.mjs && node scripts/gate-discovery.mjs && node scripts/gate-youtube-player.mjs && node scripts/gate-playback-state.mjs && node scripts/gate-playback-audio.mjs && node scripts/gate-panel-storage.mjs && node scripts/gate-language-switch.mjs && node scripts/gate-range-source.mjs && node scripts/gate-local-files.mjs && node scripts/gate-cctv-discovery.mjs",
    "prepare:store": "node scripts/prepare-store-assets.mjs",
    "verify:media-source": "node scripts/check-media-source.mjs",
    "audit:deps": "npm audit --audit-level=low --registry=https://registry.npmjs.org",
    "test:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "googlevideo": "file:vendor/googlevideo-4.1.1-qvd.96d1418.tgz",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "4.1.12",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.0.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "playwright": "^1.56.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "ws": "^8.22.0",
    "wxt": "0.21.4"
  },
  "description": "Translate video speech in the original voice, with synchronized audio, bilingual subtitles and 29 target languages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvyinchao/timbradub.git"
  },
  "homepage": "https://github.com/lvyinchao/timbradub",
  "bugs": {
    "url": "https://github.com/lvyinchao/timbradub/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
